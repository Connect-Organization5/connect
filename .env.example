# PostgreSQL 계정
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
HOST_PG_PORT=

# DB 주소
# 기본값: jdbc:postgresql://localhost:5432/connect_company
COMPANY_DB_URL=

# ===== docker compose 전체 실행용 (docker-compose.yml 이 이 파일과 같은 위치의 .env 를 읽음) =====
# JWT (gateway, user-service, delivery-service 가 같은 값을 씀)
JWT_SECRET_KEY=

# 초기 MASTER 계정 (user-service admin.masters[0])
MASTER_USERNAME=
MASTER_PASSWORD=
MASTER_EMAIL=
MASTER_AFFILIATION_TYPE=
MASTER_AFFILIATION_ID=
MASTER_SLACK_ID=

# order-service Slack 알림 (비워 두면 알림 없이 동작)
SLACK_WEBHOOK_URL=
