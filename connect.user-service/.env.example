# .env.example 을 .env 로 복사한 뒤 값을 채워서 사용 (.env 는 git 에 올리지 않음)
# 실행 위치(working directory)가 connect.user-service 폴더여야 읽힘. 같은 이름의 시스템 환경변수가 있으면 그 값이 우선

# DB
DB_URL=jdbc:postgresql://localhost:5432/connect_user
DB_USERNAME=postgres
DB_PASSWORD=

# JWT (gateway 와 같은 값)
JWT_SECRET_KEY=

# 소속별 초기 MASTER 계정 (필요할 때 주석을 풀고 [0], [1], [2] ... 로 추가)
# .env 는 properties 형식이라 admin.masters[0].username 형태로 적어야 함
# (시스템 환경변수로 넣을 때는 ADMIN_MASTERS_0_USERNAME 형태)
# 값이 하나라도 비어 있으면 시작 시 실패하므로 쓰지 않는 소속은 주석으로 둘 것
#admin.masters[0].username=
#admin.masters[0].password=
#admin.masters[0].email=
#admin.masters[0].affiliationType=
#admin.masters[0].affiliationId=
#admin.masters[0].slackId=
